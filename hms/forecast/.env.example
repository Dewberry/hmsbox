# HMS Forecast Container Environment Variables
# Copy this file to .env and fill in your values

# AWS Credentials (may not be required for local development or non-AWS environments)
# When running on AWS (EC2, ECS, Lambda), IAM roles provide credentials automatically
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket Configuration (REQUIRED)
# Specify the S3 bucket name for model data, forcing, observations, and results
HMS_S3_BUCKET=your-bucket-name
